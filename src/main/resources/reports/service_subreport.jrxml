<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="service_subreport"
              pageWidth="555" pageHeight="842"
              columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">


    <field name="name" class="java.lang.String"/>
    <field name="price" class="java.lang.Double"/>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="300" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Tên dịch vụ]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="255" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Giá]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15">
            <textField>
                <reportElement x="0" y="0" width="300" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0 VNĐ">
                <reportElement x="300" y="0" width="255" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
