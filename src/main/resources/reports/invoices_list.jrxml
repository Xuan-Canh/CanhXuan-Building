<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoices_list" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <field name="id" class="java.lang.Long"/>
    <field name="contract.customer.fullname" class="java.lang.String"/>
    <field name="contract.room.name" class="java.lang.String"/>
    <field name="invoiceDate" class="java.time.LocalDate"/>
    <field name="dueDate" class="java.time.LocalDate"/>
    <field name="roomRent" class="java.lang.Double"/>
    <field name="totalServiceFee" class="java.lang.Double"/>
    <field name="totalAmount" class="java.lang.Double"/>
    <field name="status" class="java.lang.String"/>
    <field name="paidAt" class="java.time.LocalDateTime"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="802" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[DANH SÁCH HÓA ĐƠN]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="30" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="30" y="0" width="110" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Khách hàng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="140" y="0" width="60" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Phòng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="200" y="0" width="75" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ngày lập]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="275" y="0" width="75" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Hạn TT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="350" y="0" width="80" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tiền phòng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="430" y="0" width="80" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tiền dịch vụ]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="510" y="0" width="90" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tổng tiền]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="600" y="0" width="70" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Trạng thái]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="670" y="0" width="132" height="30" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ngày thanh toán]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="30" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="30" y="0" width="110" height="25"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{contract.customer.fullname}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="0" width="60" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{contract.room.name}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="200" y="0" width="75" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{invoiceDate}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="275" y="0" width="75" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dueDate}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="350" y="0" width="80" height="25"/>
                <box rightPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{roomRent}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="430" y="0" width="80" height="25"/>
                <box rightPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalServiceFee}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="510" y="0" width="90" height="25"/>
                <box rightPadding="5"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="600" y="0" width="70" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement x="670" y="0" width="132" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{paidAt}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
